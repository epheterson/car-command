# The shape of stack/.env. `make setup` writes the real one with generated passwords;
# it exists only on the host that runs the stack and is never committed or rsynced.
DB_USER=carcommand
DB_PASSWORD=CHANGE_ME
DB_NAME=carcommand
WEBUI_USER=admin
WEBUI_PASSWORD=CHANGE_ME
REST_USER=admin
REST_PASSWORD=CHANGE_ME
# Sign-in for the site. Leave CC_PASSWORD and CC_SECRET empty and the first person to open
# it chooses the password. CC_AUTH=off when a proxy in front already signs people in (form
# tokens are still checked). CC_SECRET signs sessions; make setup writes one. Empty means
# one is generated and kept in the database, where a database dump carries it.
CC_AUTH=on
CC_PASSWORD=
CC_SECRET=
# Connecting an app (docs/api.md): empty lets any app URL scheme ask. Or list the exact redirect
# addresses you allow, comma-separated, e.g. example-app://connected. No prefixes, no added paths.
CC_APP_REDIRECTS=
# The address the site is reached at from outside, e.g. https://your-host/carcommand. The MCP snippets in Settings use it,
# and a browser request to /mcp from it is not turned away. Empty: the address the page was opened on.
CC_PUBLIC_URL=
# Sign in through Cloudflare Access (docs/install.md > Behind Cloudflare Access). The team is the name before
# .cloudflareaccess.com; the tag is the Access application's audience, which Settings can pin with one tap.
# CC_ACCESS_EMAILS lists the people who count, and the only ones who can pin it with the tap: put yours here.
# CC_ACCESS_PROXY narrows who may present the token (default: any private or loopback address).
CF_ACCESS_TEAM=
CF_ACCESS_AUD=
CC_ACCESS_PROXY=
CC_ACCESS_EMAILS=
# Seals every source kept in the app (TeslaFi, TeslaMate, Lucid, Tesla and other brands'
# sign-ins). make setup writes one; make secret-key adds one to an existing install. Lose
# it and those sources must be entered again; it is in no backup of the database.
CC_SECRET_KEY=GENERATE_KEY
# Set these only to run a second stack beside the first — a test install, a staging copy.
# Left unset, everything is named carcommand-* exactly as before.
# COMPOSE_PROJECT_NAME=carcommand
# CC_PORT=3044

# The stack's four private networks. Only set these if a default range collides on your host, or to
# run a second stack beside the first (each stack needs ranges of its own).
# CC_SUBNET=192.168.61.0/24
# CC_TESLA_SUBNET=192.168.62.0/24
# CC_TESLA_COMMANDS_SUBNET=192.168.63.0/24
# CC_TESLA_PROXY_OUT_SUBNET=192.168.64.0/24
DISCORD_WEBHOOK_URL=
# TeslaFi feed API tokens, one per vehicle (TeslaFi -> Settings -> Advanced -> API), comma separated. Empty = no live Tesla data.
# Each entry is the token alone (TESLAFI_TOKENS=abc123,def456) or the car's VIN, a colon, then the token (VIN00000000000001:abc123).
# Nothing else goes before the colon: a car's name is not a VIN, and an entry like Name:abc123 is refused with a line in the log and a notice in Settings.
TESLAFI_TOKENS=
# Telegram as a second channel for the same alerts: a bot token from @BotFather and the chat id to send to. Empty = off.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Email as a third channel: an SMTP URL with the login in it (smtps://you%40example.com:app-password@smtp.example.com:465,
# or smtp://…:587 for STARTTLS), the address to send to, and optionally the From. Empty = off.
SMTP_URL=
# One address, or several separated by commas.
EMAIL_TO=
EMAIL_FROM=
# Pushover (https://pushover.net): an application token and your user key. Empty = off.
PUSHOVER_TOKEN=
PUSHOVER_USER=
# Any receiver that takes JSON ({"source", "kind", "summary"}), with an optional Bearer token. Empty = off.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=
# The garage door, from Home Assistant, when there is no browser to link it with (Settings › Alerts ›
# Garage door › Connect is the usual way): read for the app stream's `garage` event, and opened as the
# chosen car comes home. A long-lived token made for this alone (it can do anything in HA; only the one
# cover is read and opened). Empty = off.
HA_URL=
HA_TOKEN=
HA_GARAGE_ENTITY=cover.garage_door
# A camera that sees the street and the driveway (optional; profile driveway): the door then starts
# when the car coming home is seen moving into view, not on the prediction alone. RTSP with its login.
DRIVEWAY_RTSP=
DRIVEWAY_URL=
# The driveway in the camera's frame, as fractions "x,y x,y x,y ...": a car counts once it turns in.
# Empty: anywhere in view.
DRIVEWAY_ZONE=
# Days the driveway watcher keeps a watch's frames (0 keeps them all)
DRIVEWAY_KEEP_DAYS=7

# ---- Which car, live ----------------------------------------------------------------
# The easy way for any brand is Settings › Cars and sources › Add a source › Other brand:
# it installs the connector and keeps its sign-in sealed, nothing here. What follows is the
# advanced way, building a connector into the image.
#
# CC_CONNECTORS names the CarConnectivity connector packages the connector image carries
# (pip specs, separated by semicolons). CC_CONNECTORS_JSON is the "connectors" block of the
# CarConnectivity config: the connector's type and its own settings. Both empty = the Lucid
# connector, reading /secrets/lucid-token.json (make lucid-login writes it).
#
# Lucid (the default):
#   CC_CONNECTORS=carconnectivity-connector-lucid==0.4.0
#   CC_CONNECTORS_JSON=[{"type":"lucid","config":{"refresh_token_file":"/secrets/lucid-token.json","interval":60,"driving_interval":15}}]
# Volkswagen (Skoda: connector-skoda / "skoda"; Seat and Cupra: connector-seatcupra / "seatcupra"; Audi: connector-audi / "audi"):
#   CC_CONNECTORS=carconnectivity-connector-volkswagen
#   CC_CONNECTORS_JSON=[{"type":"volkswagen","config":{"username":"you@example.com","password":"…","interval":300}}]
# Tronity (any car Tronity supports):
#   CC_CONNECTORS=carconnectivity-connector-tronity
#   CC_CONNECTORS_JSON=[{"type":"tronity","config":{"client_id":"…","client_secret":"…","interval":300}}]
# Several connectors: list both packages, and both blocks in the array. Rebuild the image
# after changing CC_CONNECTORS: docker compose -f stack/docker-compose.yml build cc
# A build not on PyPI yet: make wheel CONNECTOR=<checkout> VERSION=0.4.0.dev1 puts its wheel in
# stack/cc/wheels/ (untracked), and both images can install it from there. Pin that version:
#   CC_CONNECTORS=carconnectivity-connector-lucid==0.4.0.dev1
# Empty the folder and set the release back once it is published.
CC_CONNECTORS=
CC_CONNECTORS_JSON=
# A Tesla, live and free: point at a TeslaMate database and Car Command follows it.
# TeslaMate's Postgres must be reachable from this stack (publish its port, or join the networks).
TESLAMATE_DB_URL=

# Connect Tesla (Settings › Cars and sources › Connect Tesla). Your own app at
# developer.tesla.com; the page lists the values to paste there. These three are
# optional: the page takes them too (sealed, no restart), and what is set here wins.
# TESLA_DOMAIN is the public hostname this site is reached on; Tesla reads the key from it.
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_DOMAIN=
# Only when the site sits under a path on that domain, e.g. /carcommand:
# TESLA_REDIRECT_URI=https://your.domain/carcommand/settings/sources/tesla/callback
# The cars' live stream, through Tailscale Funnel (docs/tesla-stream.md): the Funnel
# node's name. The auth key goes in secrets/ through `make tesla-net-key`, never here.
# TESLA_STREAM_HOST=carcommand-stream.your-tailnet.ts.net
# Tesla commands (docs/commands.md): Tesla's signing proxy. The one container runs it by itself;
# with compose, start it (docker compose --profile commands up -d tesla-proxy) and set:
# TESLA_PROXY_URL=https://tesla-proxy:4443

# Find my plan (Settings › Money) searches OpenEI's Utility Rate Database with a free key
# pasted on that page. Or point this at a relay that holds a key and takes the same
# parameters (OpenEI's utility_rates, without api_key); then no key is asked for.
# CC_URDB_URL=https://your.relay/utility_rates

# How often an open Now page re-draws its car's card, in seconds (it sends only what changed).
# CC_STREAM_S=15

# Local maps add-on: set to http://maps:8090 when you run the `maps` profile.
MAPS_URL=

# The time zone dates are shown in until one is picked on Settings › Units and look.
# TZ=America/Los_Angeles

# Where the rate averages are downloaded from (docs/costs.md); blank is the project's own.
# CC_RATES_URL=https://your.mirror/averages.json
