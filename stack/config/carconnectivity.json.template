{
    "carConnectivity": {
        "log_level": "info",
        "locale": "en_US.UTF-8",
        "connectors": ${CC_CONNECTORS_JSON},
        "plugins": [
            {
                "type": "database",
                "config": {
                    "db_url": "postgresql://${PLUGIN_DB_USER}:${PLUGIN_DB_PASSWORD}@${DB_HOST}:5432/${DB_NAME}",
                    "log_level": "warning"
                }
            },
            {
                "type": "webui",
                "config": {
                    "host": "0.0.0.0",
                    "port": 4000,
                    "username": "${WEBUI_USER}",
                    "password": "${WEBUI_PASSWORD}",
                    "log_level": "warning"
                }
            },
            {
                "type": "restapi",
                "config": {
                    "host": "0.0.0.0",
                    "port": 40000,
                    "username": "${REST_USER}",
                    "password": "${REST_PASSWORD}",
                    "log_level": "warning"
                }
            }
        ]
    }
}
