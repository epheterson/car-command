{
  "host": "127.0.0.1",
  "port": 4443,
  "log_level": "info",
  "json_log_enable": true,
  "namespace": "tesla_telemetry",
  "reliable_ack": false,
  "transmit_decoded_records": true,
  "records": {
    "V": ["zmq"],
    "connectivity": ["zmq"],
    "alerts": ["zmq"],
    "errors": ["zmq"]
  },
  "zmq": {
    "addr": "ipc:///run/tesla-stream/zmq.sock"
  },
  "tls": {
    "server_cert": "/data/tesla/certs/tls.crt",
    "server_key": "/data/tesla/certs/tls.key"
  }
}
