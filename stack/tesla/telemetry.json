{
  "host": "0.0.0.0",
  "port": 4443,
  "log_level": "info",
  "json_log_enable": true,
  "namespace": "tesla_telemetry",
  "reliable_ack": false,
  "transmit_decoded_records": true,
  "records": {
    "V": ["zmq"],
    "connectivity": ["zmq"],
    "alerts": ["zmq"],
    "errors": ["zmq"]
  },
  "zmq": {
    "addr": "tcp://*:5284"
  },
  "tls": {
    "server_cert": "/certs/tls.crt",
    "server_key": "/certs/tls.key"
  }
}
